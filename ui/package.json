{
	"name": "sesh-ai-extension-ui",
	"version": "0.1.0",
	"private": true,
	"description": "Sesh AI REAPER extension UI — React/TypeScript chat surface built by Vite into static assets that CEF loads from file://",
	"type": "module",
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"i18next": "26.4.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "17.0.15",
		"react-markdown": "10.1.0"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.13.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"eslint": "9.39.5",
		"eslint-config-airbnb-extended": "3.2.0",
		"fast-check": "4.10.2",
		"globals": "17.12.0",
		"jsdom": "29.1.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1",
		"vite": "8.3.1",
		"vitest": "5.0.1"
	}
}
